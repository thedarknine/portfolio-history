{% extends 'layout.html.twig' %}

{% block title %}Expérience{% endblock %}
{% block pagetitle %}Expériences professionnelles{% endblock %}

{% block body %}
    {% for experience in data.experiencesList %}
        <section class="bg-gray {% if loop.index is even %}lighten{% endif %}">
            {% if loop.index is even %}
                {% include 'blocks/curvedown.html' with {'color': 'curve-down-color'} %}
            {% endif %}

            <div class="container">
                <div class="row justify-content-center mt-40 mb-40">
                    <div class="col-lg-6 col-md-12 xp-resume {% if loop.index is odd %}yellow{% endif %}">
                        <h1 class="text-nine-indigo">{{ experience.startDate|date("Y") }}</h1>
                        <h3 class="text-nine-blue text-uppercase mb-10">{{ experience.title }}</h3>

                        <div class="xp-info mt-20">
                            <p class="date"><i class="far fa-calendar-alt mr-5"></i>&nbsp;
                                {% if experience.endDate is empty %}
                                    Depuis {{ experience.startDate|date("m/Y") }}
                                {% else %}
                                    De {{ experience.startDate|date("m/Y") }} à {{ experience.endDate|date("m/Y") }}
                                {% endif %}
                                <i class="text-09">(
                                    {% if experience.duration.nbYears > 0 %}
                                        {{ experience.duration.nbYears }}
                                        {% if experience.duration.nbYears == 1 %}
                                            an
                                        {% else %}
                                            ans
                                        {% endif %}
                                    {% endif %}
                                    {% if experience.duration.nbMonths != 0 %}
                                        {% if experience.duration.nbYears > 0 %}
                                            et
                                        {% endif %}
                                        {{ experience.duration.nbMonths }} mois
                                    {% endif %}
                                    )</i>
                            </p>
                            <p class="text-muted"><i class="fas fa-map-marker-alt mr-5"></i> {{ experience.company.name }}
                                - <span class="text-09">{{ experience.company.city }} ({{ experience.company.department|format_number({min_integer_digit: '2'}) }})</span>
                            </p>
                        </div>
                        <div class="">
                            <img src="{{ absolute_url('images/company/' ~ experience.company.logo) }}" alt="{{ experience.company.name }}" width="100px" />
                        </div>
                    </div>

                    <h4 class="text-nine-indigo text-center pt-40 pb-20" data-aos="fade-down" data-aos-easing="ease-in-out" data-aos-duration="600">{{ experience.subtitle }}</h4>

                    <div class="{% if experience.skills is not empty %}col-lg-9{% else %}col-lg-12{% endif %} col-md-12" data-aos="fade-right" data-aos-duration="1000" data-aos-delay="800">
                        <div class="">
                            {{ experience.description|raw }}
                        </div>
                    </div>
                    {% if experience.skills is not empty %}
                        <div class="col-lg-3 col-md-12 xp-stack" data-aos="fade-left" data-aos-duration="1000" data-aos-delay="800">
                            <p class="pl-20"><b class="">Stack technique</b></p>
                            <div class="ml-20 mb-10">
                                {% for skill in experience.skills %}
                                    <img src="{{ absolute_url('images/skills/' ~ skill.logo) }}" alt="{{ skill.name }}" width="40px" class="mr-10" data-toggle="tooltip" data-placement="right" title="{{ skill.name }}" />
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            {% if loop.index is even %}
                {% include 'blocks/curveup.html' with {'color': 'curve-up-color'} %}
            {% elseif loop.last %}
                {% include 'blocks/curveup.html' with {'color': 'curve-up-color-light'} %}
            {% endif %}
        </section>
    {% endfor %}

{% endblock %}
