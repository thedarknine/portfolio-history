{% extends 'layout.html.twig' %}

{% block title %}Expérience{% endblock%}
{% block pagetitle %}Expériences professionnelles{% endblock%}

{% block body %}
    <section class="timeline pb-20">

        <div class="container pl-10">
            <!-- Timeline -->
            <ul class="timeline">
                {% for experience in data.listExperiences %}
                <li class="timeline-item bg-white rounded ml-30 p-4 shadow {{experience.company.label}} wow fadeInRight" id="" >
                    <div class="timeline-arrow"></div>
                    <div class="">
                        <img src="{{ absolute_url('images/company/' ~ experience.company.label ~ '.png') }}" alt="{{experience.company.name}}" width="60px" class="float-end mt-10">
                    </div>
                    <h5 class="h5 text-nine-blue mb-10"><span class="text-nine-indigo pr-15">{{experience.startDate|date("Y")}}</span> {{experience.title}}</h5>

                    <div class="xp-info ml-20">
                        <span class="date"><i class="far fa-calendar-alt mr-5"></i>&nbsp;
                            {% if experience.endDate is empty %}
                                Depuis {{experience.startDate|date("m/Y")}}
                            {% else %}
                                De {{experience.startDate|date("m/Y")}} à {{experience.endDate|date("m/Y")}}
                            {% endif %}
                            <i class="text-09">(
                            {% if experience.duration.nbYears > 0 %}
                                {{ experience.duration.nbYears }}
                                {% if experience.duration.nbYears == 1 %}
                                    an
                                {% else %}
                                    ans
                                {% endif %}
                            {% endif %}
                                {%  if experience.duration.nbMonths != 0  %}
                                    {%  if experience.duration.nbYears > 0  %}
                                        et
                                    {% endif %}
                                    {{ experience.duration.nbMonths }} mois
                                {% endif %}
                            )</i>
                        </span>
                        <span class="text-muted ml-20"><i class="fas fa-map-marker-alt mr-5"></i> {{experience.company.name}}
                            - <span class="text-09">{{experience.company.city}} ({{experience.company.department}})</span>
                        </span>
                    </div>
                    <p class="mt-20 mb-10"><strong class="text-12 text-nine-indigo">{{experience.subtitle}}</strong></p>

                    <div class="">
                        {{experience.description|raw}}

                        {% if experience.skills is not empty %}
                            <p class="mt-30"><b class="">Stack technique</b></p>
                            <div class="ml-20 mb-10">
                                {% for skill in experience.skills %}
                                    {% if skill.disable == 0 %}
                                    <img src="{{ absolute_url('images/skills/' ~ skill.label ~ '.png') }}" alt="{{skill.title}}" width="40px" class="mr-10">
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </li>
                {% endfor %}
            </ul><!-- End -->

        </div>
    </section>
{% endblock %}