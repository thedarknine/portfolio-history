{% extends 'layout.html.twig' %}

{% block title %}Compétences{% endblock %}
{% block pagetitle %}Compétences{% endblock %}

{% block body %}
    <div class="mt-40"></div>
    {% for type in data.skillTypesList %}
        <section class="bg-gray {% if loop.index is even %}lighten{% endif %}">
            {% if loop.index is even %}
                {{ include('blocks/curvedown.html') }}
            {% endif %}

            <div class="container mb-40">

                <div class="row">
                    <h3 class="text-nine-blue text-uppercase text-center {% if loop.index is even %}bg-item-blue{% else %}bg-item-indigo{% endif %} pt-40 pb-40">{{ type.name }}</h3>

                    <div class="col-lg-4 col-md-12 text-center">
                        <img src="{{ absolute_url('images/skills/' ~ type.logo) }}" alt="{{ type.name }}" width="250px" />
                    </div>

                    <div class="col-lg-8 col-md-12">
                        <div class="row">
                            {% set skills = data.skillsList[type.label] %}
                            {% for skill in skills %}
                                <div class="col-lg-4 col-md-6 mb-10">
                                    <div class="card shadow-sm p-20 mb-10" data-aos="{{ random(effects) }}" data-aos-easing="ease-in-out" data-aos-duration="600" data-aos-delay="{{ 600 + (loop.index0 * 300) }}">
                                        <h4 class="">{{ skill.name|raw }}</h4>
                                        <span class="text-09 text-muted">
                                        {% if skill.duration is not empty %}
                                            XP  {{ skill.duration }}
                                        {% else %}
                                            <em>En cours...</em>
                                        {% endif %}
                                    </span>

                                        <div class="progress mx-auto" data-value='{{ skill.level * 10 }}'>
                                        <span class="progress-left">
                                            <span class="progress-bar"></span>
                                        </span>
                                            <span class="progress-right">
                                            <span class="progress-bar"></span>
                                        </span>
                                            <div class="progress-value w-100 h-100 rounded-circle d-flex align-items-center justify-content-center">
                                                <img src="{{ absolute_url('images/skills/' ~ skill.label ~ '.png') }}" alt="{{ skill.name }}" width="60px" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                    </div>
                </div>
            </div>

            {% if loop.index is even %}
                {{ include('blocks/curveup.html') }}
            {% elseif loop.last %}
                {{ include('blocks/curvedown.html') }}
            {% endif %}
        </section>
    {% endfor %}
{% endblock %}
