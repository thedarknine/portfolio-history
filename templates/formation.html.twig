{% extends 'layout.html.twig' %}

{% block title %}Formation{% endblock%}
{% block pagetitle %}Formation universitaire{% endblock%}

{% block body %}
    <section class="timeline pb-20">
        <div class="container pl-10">
            {% for education in data.listEducations %}
            <div class="timeline-item {{education.school.label}}" id="{{education.label}}">
                <div class="timeline-img"></div>
                <div class="timeline-content timeline-card">
                    <div class="right">
                        <img src="{{ absolute_url('images/school/' ~ education.school.label ~ '.png') }}" alt="{education.school.name}}" width="60px" class="mt-10">
                    </div>
                    <h5 class="left-align valign-wrapper text-12 text-nine-blue mb-0 pb-0"><span class="text-nine-indigo pr-15">{{education.year}}</span> {{education.title}}</h5>
                    <p class="mt-0 pt-0">
                        {{education.school.name}}
                        - <span class="text-09">{{education.school.city}} ({{education.school.department}})</span>
                    </p>

                    <div class="">
                        <p class="mt-0 mb-5"><strong class="text-12">{{education.details}}</strong></p>
                        <p class="mt-0">
                            Option : <b>{{education.speciality}}</b>
                            <br>
                            {% if education.mention is not empty %}
                                Mention : <b>{{education.mention}}</b>
                                <br>
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}
