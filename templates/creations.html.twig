{% extends 'layout.html.twig' %}

{% block title %}Créations{% endblock%}
{% block pagetitle %}Créations{% endblock%}

{% block body %}
    {% for type in data.listCreationTypes %}
    <section class="timeline {% if loop.first %}pt-0{% endif %} {% if loop.index is odd %}odd{% else %}even{% endif %}">
        <div class="container">
            <h5 class="center-align text-lg text-nine-blue mb-20 pl-10 pb-20">{{type.name}}</h5>

            <div class="row">
                {% set listItemsCreations = data.listCreations[type.label] %}
                {% for creation in listItemsCreations %}
                <div class="col s6 m4 l3 xl3 center-align mb-20 ">
                    <div><img src="{{ absolute_url('images/creations/' ~ type.label ~ '/' ~ creation) }}" alt="" class="z-depth-1 responsive-img bordered"></div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% if loop.index is even %}
            <div class="degree-left"></div>
        {% endif %}
    </section>
    {% endfor %}
{% endblock %}