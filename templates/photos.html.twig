{% extends 'layout.html.twig' %}

{% block title %}Photos{% endblock %}
{% block pagetitle %}Photos{% endblock %}

{% block body %}
    <div class="mt-40"></div>
    {% for type in data.photoTypesList %}
        <section class="bg-gray {% if loop.index is even %}lighten{% endif %}">
            {% if loop.index is even %}
                {% include 'blocks/curvedown.html' with {'color': 'curve-down-color'} %}
            {% endif %}

            <div class="container">
                <h3 class="text-center text-nine-blue text-uppercase mb-20 mt-30 pb-20 {% if loop.index is even %}bg-item-blue{% else %}bg-item-indigo{% endif %}">{{ type.name }}</h3>

                <div class="row justify-content-center">
                    {% set listItemsPhotos = data.photosList[type.label] %}
                    {% for photo in listItemsPhotos %}
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-20" data-aos="{{ random(effects) }}" data-aos-easing="ease-in-out" data-aos-duration="600" data-aos-delay="{{ 600 + (loop.index0 * 300) }}">
                            <div class="nine-shadow mb-10">
                                <a href="{{ absolute_url('images/photos/' ~ type.label ~ '/' ~ photo.filename) }}" data-toggle="lightbox" data-gallery="{{ type.label }}-gallery" data-caption="{{ photo.caption }}">
                                    <img src="{{ absolute_url('images/photos/' ~ type.label ~ '/' ~ photo.filename) }}" alt="" class="rounded img-fluid">
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {% if loop.index is even %}
                {% include 'blocks/curveup.html' with {'color': 'curve-up-color'} %}
            {% elseif loop.last %}
                {% include 'blocks/curveup.html' with {'color': 'curve-up-color-light'} %}
            {% endif %}
        </section>
    {% endfor %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bs5-lightbox@1.8.3/dist/index.bundle.min.js"></script>
{% endblock %}
