    <section id="creations" class="bg-darkblue py-10">
        <h2 class="w-full my-2 text-4xl font-bold leading-tight text-center font-accent">Créations</h2>
        <div class="w-full mb-4">
            <div class="h-1 mx-auto bg-light w-64 opacity-25 my-0 py-0 rounded-t"></div>
        </div>

        <div class="container mx-auto py-8">
            <div class="grid-cols-4 p-8 md:space-y-0 md:grid md:gap-3 md:grid-rows-3">
                {% for creation in data.creationsList %}
                    {% if loop.index == 2 or loop.index == 6 %}
                        <div class="w-full col-span-2 row-span-2 rounded-lg">
                    {% else %}
                        <div class="w-full rounded-lg">
                    {% endif %}
                            <img alt="Créations" class="block h-full w-full rounded-lg object-cover object-center sm:my-4 lg:my:0 hover:scale-110 transition ease-in-out duration-500" src="{{ absolute_url('images/creations/' ~ creation) }}" />
                        </div>
