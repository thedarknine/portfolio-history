            <div class="row">
                <h2 class="mb-50" id="">Experience</h2>

                <div class="col-lg-5 col-md-12 col-sm-12">
                    <div class="select-content">
                        <div class="select-box">
                            {% for experience in data.lastExperiences %}
                            <div class="select-single {% if loop.first %}active{% endif %}" data-target="xp-{{ experience.label }}">
                                <div class="select-icon">
                                    <img src="{{ absolute_url('images/company/' ~ experience.company.label ~ '.png') }}" alt="{{experience.company.name}}" width="60px" class="">
                                </div>
                                <div class="select-info">
                                    <h3>{{ experience.title }}</h3>
                                    <p>{{ experience.subtitle }}</p>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>

                </div>
                <div class="col-lg-7 col-md-12 choose-content">
                    {% for experience in data.lastExperiences %}
                    <div class="fade {% if loop.first %}show active{% else %}inactive{% endif %}" id="xp-{{ experience.label }}">
                        <div class="card-body">
                            {{experience.description|raw}}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row">
                <div class="text-center mt-30"><a class="btn-primary-nine" href="#"><span>En savoir plus</span></a></div>
            </div>
        </div>


    </section>

    <section id="competences" class="section-padding">
        <div class="container">
            <div class="row">
                <h2 class="mb-50" id="">Compétences</h2>

            </div>
        </div>
    </section>

    <section id="creations" class="bg-gray section-padding">
        <div class="container">
            <div class="row">
                <h2 class="mb-50" id="">Créations</h2>

                <div class="nine-carousel">
                    {% for creation in data.listCreations %}
                    <div class="item"><img src="{{ absolute_url('images/creations/' ~ creation) }}" alt="" class="rounded shadow-sm"></div>
                    {% endfor %}
                </div>

            </div>
        </div>

        <div class="text-center mt-30"><a class="btn-primary-nine" href="#"><span>Afficher plus</span></a></div>
    </section>

    {# https://getbootstrap.com/docs/4.1/components/carousel/#crossfade #}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ absolute_url('js/typed.js') }}"></script>
    <script src="{{ absolute_url('js/nine.js') }}"></script>
{% endblock %}