<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">

        <meta name="keywords" content="CV,Design,Product Owner,Développeur,Développeur web full-stack,PHP,Symfony">
        <meta name="author" content="Caroline Noyer">
        <link rel="shortcut icon" type="image/x-icon" href="./favicon.ico">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="index,follow">

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-+0n0xVW2eSR5OomGNYDnhzAbDsOXxcvSN1TPprVMTNDbiYZCxYbOOl7+AMvyTG2x" crossorigin="anonymous">
        <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

        <!-- MDB -->
        <!--link href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/3.6.0/mdb.min.css" rel="stylesheet" /-->

        <link rel="stylesheet" type="text/css" href="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css">

        <title>Caroline Noyer | {% block title %}Product Owner{% endblock %}</title>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
            {{ encore_entry_link_tags('main') }}
        {% endblock %}
        <!--link href="{{ absolute_url('css/owl.carousel.min.css') }}" rel="stylesheet">
        <link href="{{ absolute_url('css/owl.theme.default.min.css') }}" rel="stylesheet"-->
    </head>
    <body class="" data-bs-target="#navbar-main" id="{{ page }}">

        <!-- Start Navbar Area-->
        <nav class="navbar navbar-nine navbar-expand-md fixed-top {% if page == "home" %}navbar-trans{% else %}navbar-reduce{% endif %}" id="mainNav">
            <div class="container">
                <a class="navbar-brand js-scroll" href="/">
                    <img src="{{ absolute_url('images/logo-nine.png') }}" alt="TheDarkNine" width="30" class="d-inline-block align-text-top">
                    Caroline Noyer
                </a>
                <button class="navbar-toggler collapsed" type="button" data-toggle="collapse" data-target="#navbarDefault" aria-controls="navbarDefault" aria-expanded="false" aria-label="Toggle navigation"> <span></span>
                    <span></span>
                    <span></span>
                </button>
                <div class="navbar-collapse collapse justify-content-end" id="navbar-main">
                    <ul class="nav navbar-nav">
                        <li class="nav-item{% if page == "experience" %} active{% endif %}"><a href="/experience" class="nav-link hvr-underline-from-center">Expérience</a></li>
                        <li class="nav-item{% if page == "competences" %} active{% endif %}"><a href="/competences" class="nav-link hvr-underline-from-center">Compétences</a></li>
                        <li class="nav-item{% if page == "formation" %} active{% endif %}"><a href="/formation" class="nav-link hvr-underline-from-center">Formation</a></li>
                        <li class="nav-item{% if page == "projets" %} active{% endif %}"><a href="/projets" class="nav-link hvr-underline-from-center">Projets</a></li>
                        <li class="nav-item{% if page == "creations" %} active{% endif %}"><a href="/creations" class="nav-link hvr-underline-from-center">Créations</a></li>
                        <li class="nav-item{% if page == "photos" %} active{% endif %}"><a href="/photos" class="nav-link hvr-underline-from-center">Photos</a></li>
                        <li class="nav-item{% if page == "arcade" %} active{% endif %}"><a href="/arcade" class="nav-link hvr-underline-from-center">Arcade</a></li>
                    </ul>
                </div>
            </div>
        </nav>
        <!-- End Navbar Area -->

        {% if page != 'home' %}
            <div class="mt-50">&nbsp;</div>
            <div class="container">
                <div class="row">
                    <div class="col s12">
                        <div class=""><h3 class="mt-40">{% block pagetitle %}{% endblock %}</h3></div>
                    </div>
                </div>
            </div>
        {% else %}
            <!-- Start Home Section -->
            <header class="home-area header-nine section-padding overflow-hidden d-flex align-items-center">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-12 col-md-7 col-lg-6">
                            <div class="text-left home-content z-index position-relative">
                                <h1>Product Owner &amp; Développeur PHP Senior</h1>
                                <!--a href="#about" class="btn btn-light js-scroll">En savoir plus</a-->

                                <p class="banner mt-10">
                                    <a href="https://www.linkedin.com/in/carolinenoyer" data-bs-toggle="tooltip" data-bs-placement="right" title="LinkedIn"><span><i class="fa fa-linkedin"></i></span></a>
                                    <a href="https://twitter.com/CaroNoyer" data-bs-toggle="tooltip" data-bs-placement="right" title="Twitter"><span><i class="fa fa-twitter"></i></span></a>
                                    <a href="https://github.com/thedarknine" data-bs-toggle="tooltip" data-bs-placement="right" title="GitHub"><span><i class="fa fa-github-alt"></i></span></a>
                                    <a href="https://dribbble.com/TheDarkNine" data-bs-toggle="tooltip" data-bs-placement="right" title="Dribbble"><span><i class="fab fa-dribbble"></i></span></a>
                                    <a href="http://docs.carolinenoyer.info/pdf/cv-cnoyer-productowner.pdf" data-bs-toggle="tooltip" data-bs-placement="right" title="CV au format PDF"><span><i class="fa fa-file-pdf"></i></span></a>
                                </p>
                            </div>
                        </div>
                        <div class="col-12 col-md-5 col-lg-6">
                            <div class="text-center z-index position-relative home-image animation-bounce-custom">
                                <img src="images/logo-nine-light.png" class="img-fluid w-75" alt="">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="svg-shape-bottom">
                    <img src="images/wave-shape.svg" class="bottom-shape img-fluid" alt="">
                </div>
            </header>
            <!-- End Home Section -->
        {% endif %}

        {% block body %}{% endblock %}

        <div class="back-to-top" style="display: none;"><i class="fa fa-caret-up"></i></div>

        <footer class="page-footer">
            <div class="container">
                <div class="row py-4">
                    <div class="col-lg-2 col-md-6 mb-4 mb-lg-0">
                        <h6 class="text-uppercase font-weight-bold mb-4">Shop</h6>
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2"><a href="#" class="text-muted">For Women</a></li>
                            <li class="mb-2"><a href="#" class="text-muted">For Men</a></li>
                            <li class="mb-2"><a href="#" class="text-muted">Stores</a></li>
                            <li class="mb-2"><a href="#" class="text-muted">Our Blog</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-2 col-md-6 mb-4 mb-lg-0">
                        <h6 class="text-uppercase font-weight-bold mb-4">Company</h6>
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2"><a href="#" class="text-muted">Login</a></li>
                            <li class="mb-2"><a href="#" class="text-muted">Register</a></li>
                            <li class="mb-2"><a href="#" class="text-muted">Wishlist</a></li>
                            <li class="mb-2"><a href="#" class="text-muted">Our Products</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-lg-0">
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4 mb-lg-0"><img src="{{ asset('images/logo-nine-light.png') }}" alt="" width="100" class="mb-3">
                        <p class="font-italic text-muted">Site under reconstruction...</p>
                        <ul class="list-inline mt-4">
                            <li class="list-inline-item"><a href="#" target="_blank" title="twitter"><i class="fa fa-linkedin"></i></a></li>
                            <li class="list-inline-item"><a href="#" target="_blank" title="facebook"><i class="fa fa-twitter"></i></a></li>
                            <li class="list-inline-item"><a href="#" target="_blank" title="instagram"><i class="fa fa-github-alt"></i></a></li>
                            <li class="list-inline-item"><a href="#" target="_blank" title="pinterest"><i class="fab fa-dribbble"></i></a></li>
                            <li class="list-inline-item"><a href="http://docs.carolinenoyer.info/pdf/cv-cnoyer-productowner.pdf"><span><i class="fa fa-file-pdf"></i></span></a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Copyrights -->
            <div class="copyright py-4">
                <div class="container text-center">
                    <p class="mb-0 py-2"><b>©Nine Copyright</b> 2006-2021</p>
                </div>
            </div>
        </footer>

        {% block javascripts %}
            <!-- Compiled and minified JavaScript -->
            <script src="https://kit.fontawesome.com/4266107922.js" crossorigin="anonymous"></script>
            <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/js/bootstrap.min.js" integrity="sha384-Atwg2Pkwv9vp0ygtn1JAojH0nYbwNJLPhwyoVbhoPwBhjQPR5VtM2+xf0Uwh9KtT" crossorigin="anonymous"></script>

            <!-- MDB -->
            <!--script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/3.6.0/mdb.min.js"></script-->

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-gtEjrD/SeCtmISkJkNUaaKMoLD0//ElJ19smozuHV6z3Iehds+3Ulb9Bn9Plx0x4" crossorigin="anonymous"></script>
            <script type="text/javascript" src="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

            <script src="https://cdnjs.cloudflare.com/ajax/libs/wow/1.1.2/wow.min.js" integrity="sha512-Eak/29OTpb36LLo2r47IpVzPBLXnAMPAVypbSZiZ4Qkf8p/7S/XRG5xp7OKWPPYfJT6metI+IORkR5G8F900+g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>


            {{ encore_entry_script_tags('app') }}

            <!-- Global site tag (gtag.js) - Google Analytics -->
            <script async src="https://www.googletagmanager.com/gtag/js?id=UA-35928055-1"></script>
            <script>
                /*window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());

                gtag('config', 'UA-35928055-1');*/
            </script>
        {% endblock %}
    </body>
</html>
