<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">

        <meta name="keywords" content="CV,Design,Product Owner,Développeur,Développeur web full-stack,PHP,Symfony">
        <meta name="author" content="Caroline Noyer">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="index,follow">

        <link rel="shortcut icon" type="image/x-icon" href="./favicon.ico">

        <title>Caroline Noyer | {% block title %}Product Owner{% endblock %}</title>

        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
        {% endblock %}
    </head>
    <body id="{{ page }}>
        {{ page }}<br>

    <footer class="page-footer">
    <div class="container">
        <div class="row py-4">
            <div class="col-lg-2 col-md-6 mb-4 mb-lg-0">
                <h6 class="text-uppercase font-weight-bold mb-4">Parcours</h6>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><a href="/experience" class="text-muted">Expérience</a></li>
                    <li class="mb-2"><a href="/competences" class="text-muted">Compétences</a></li>
                    <li class="mb-2"><a href="/formation" class="text-muted">Formation</a></li>
                    <li class="mb-2"><a href="/projets" class="text-muted">Projets</a></li>
                </ul>
            </div>
            <div class="col-lg-2 col-md-6 mb-4 mb-lg-0">
                <h6 class="text-uppercase font-weight-bold mb-4">Centres d'intérêt</h6>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><a href="/creations" class="text-muted">Créations</a></li>
                    <li class="mb-2"><a href="/photos" class="text-muted">Photos</a></li>
                    <li class="mb-2"><a href="/arcade" class="text-muted">Arcade</a></li>
                </ul>
            </div>
            <div class="col-lg-4 col-md-6 mb-lg-0">
            </div>
            <div class="col-lg-4 col-md-6 mb-4 mb-lg-0 follow-me"><img src="{{ asset('images/logo-nine-2021.png') }}" alt="" width="100" class="mb-3">
                <p class="font-italic text-muted mt-4">Suivez-moi !</p>
                <ul class="list-inline">
                    <li class="list-inline-item"><a href="https://www.linkedin.com/in/carolinenoyer" target="_blank" title="LinkedIn"><i class="fa fa-linkedin"></i></a></li>
                    <li class="list-inline-item"><a href="https://twitter.com/CaroNoyer" target="_blank" title="Twitter"><i class="fa fa-twitter"></i></a></li>
                    <li class="list-inline-item"><a href="https://github.com/thedarknine" target="_blank" title="GitHub"><i class="fa fa-github-alt"></i></a></li>
                    <li class="list-inline-item"><a href="https://dribbble.com/TheDarkNine" target="_blank" title="Dribbble"><i class="fab fa-dribbble"></i></a></li>
                    <li class="list-inline-item"><a href="http://docs.carolinenoyer.info/pdf/cv-cnoyer-productowner.pdf" title="CV au format PDF"><span><i class="fa fa-file-pdf"></i></span></a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Copyrights -->
    <div class="copyright py-4">
        <div class="container text-center">
            <p class="mb-0 py-2"><b>©Nine Copyright</b> 2006-2021</p>
            <a href="https://fr.freepik.com/upklyak">Infographies vecteur créées par upklyak - fr.freepik.com</a>
        </div>
    </div>
    </footer>

    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    {% endblock %}

    </body>
</html>
