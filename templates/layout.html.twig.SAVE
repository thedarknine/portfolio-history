        <!-- button class="back-to-top" data-targets="html"><i class="fa fa-angle-up"></i></button -->

        {% block body %}{% endblock %}

        <!--Footer-->
        <footer class="bg-blue-dark mt-20">
        <div class="container mx-auto px-8">
        <div class="w-full flex flex-col md:flex-row py-20">
            <div class="flex-1 mb-6 text-white">
                <img src="{{ asset('images/logo-nine-2021.png') }}" alt="" width="100" class="mb-3">
                <ul class="flex mt-5 space-x-4">
                    <li><a href="https://www.linkedin.com/in/carolinenoyer" target="_blank" title="LinkedIn" class="text-gray-400 hover:text-turquoise"><i class="fa fa-linkedin"></i></a></li>
                    <li><a href="https://github.com/thedarknine" target="_blank" title="GitHub" class="text-gray-400 hover:text-turquoise"><i class="fa fa-github-alt"></i></a></li>
                    <li><a href="https://docs.carolinenoyer.fr/pdf/cv-cnoyer-productowner.pdf" title="CV au format PDF" class="text-gray-400 hover:text-turquoise"><span><i class="fa fa-file-pdf"></i></span></a></li>
                </ul>
            </div>
            <div class="flex-1">
            </div>
            <div class="flex-1">
            <p class="text-smallcaps text-light md:mb-4">Parcours</p>
            <ul class="list-reset mb-6">
                <li class="mt-2 inline-block mr-2 md:block md:mr-0"><a href="/experience" class="text-gray-400 hover:text-turquoise no-underline hover:underline">Expérience</a></li>
                <li class="mt-2 inline-block mr-2 md:block md:mr-0"><a href="/competences" class="text-gray-400 hover:text-turquoise no-underline hover:underline">Compétences</a></li>
                <li class="mt-2 inline-block mr-2 md:block md:mr-0"><a href="/formation" class="text-gray-400 hover:text-turquoise no-underline hover:underline">Formation</a></li>
                <li class="mt-2 inline-block mr-2 md:block md:mr-0"><a href="/projets" class="text-gray-400 hover:text-turquoise no-underline hover:underline">Projets</a></li>
            </ul>
            </div>
            <div class="flex-1">
            <p class="text-smallcaps text-light md:mb-4">Centres d'intérêt</p>
            <ul class="list-reset mb-6">
                <li class="mt-2 inline-block mr-2 md:block md:mr-0"><a href="/creations" class="text-gray-400 hover:text-turquoise no-underline hover:underline">Créations</a></li>
                <li class="mt-2 inline-block mr-2 md:block md:mr-0"><a href="/photos" class="text-gray-400 hover:text-turquoise no-underline hover:underline">Photos</a></li>
                <li class="mt-2 inline-block mr-2 md:block md:mr-0"><a href="/arcade" class="text-gray-400 hover:text-turquoise no-underline hover:underline">Arcade</a></li>
            </ul>
            </div>
            <!--div class="flex-1">
            <p class="text-smallcaps text-light md:mb-4">Legal</p>
            <ul class="list-reset mb-6">
                <li class="mt-2 inline-block mr-2 md:block md:mr-0">
                <a href="#" class="no-underline hover:underline text-gray-800 hover:text-pink-500">Terms</a>
                </li>
                <li class="mt-2 inline-block mr-2 md:block md:mr-0">
                <a href="#" class="no-underline hover:underline text-gray-800 hover:text-pink-500">Privacy</a>
                </li>
            </ul>
            </div -->
        </div>
        </div>

        <!-- Copyrights -->
        <div class="text-xs text-center bg-blue-dark text-gray-400 pt-4 pb-24">
            <p class="mb-0 py-2"><b>©Nine | Copyright</b> 2006-{{ "now"|date("Y") }}</p>
            <a href="https://fr.freepik.com/auteur/upklyak">Infographies vecteur créées par upklyak - fr.freepik.com</a>
        </div>
    </div>
    </footer>
        

