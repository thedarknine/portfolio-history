{% extends 'layout.html.twig' %}

{% block title %}Projets{% endblock %}
{% block pagetitle %}Projets réalisés{% endblock %}

{% block body %}
    <div class="container mt-40 mb-50">
        <div class="row">
            <div class="col-lg-6">
                <h1 class="pt-30">Side projects</h1>
            </div>
            <div class="col-lg-6 text-right">
                <img src="{{ absolute_url('images/projets.png') }}" alt="Projets" width="500px" />
            </div>
        </div>
    </div>

    {% for project in data.projectsList %}
        <section class="bg-gray {% if loop.index is odd %}lighten{% endif %}">
            {% if loop.index is odd %}
                {% include 'blocks/curvedown.html' with {'color': 'curve-down-color'} %}
            {% endif %}

            <div class="container">
                <div class="row mt-40 mb-40">
                    <div class="col-lg-12 col-md-12 xp-resume {% if loop.index is odd %} yellow{% endif %}">
                        <h2 class="text-nine-indigo text-uppercase">{{ project.name }}</h2>
                        <h4 class="text-nine-blue mb-10">{{ project.period }}</h4>

                        <div class="">
                            <img src="{{ absolute_url('images/project/' ~ project.logo) }}" alt="{{ project.name }}" width="90px" class="" />
                        </div>
                    </div>

                    <div class="resume pb-10 text-center">
                        {{ project.description|raw }}

                        {% if project.file is not empty %}
                            <p class="center-align pt-20"><a class="btn btn-flat btn-nine waves-effect waves-light hvr-grow-shadow" href="http://docs.carolinenoyer.fr/pdf/{{ project.file }}" title="Rapport de stage"><i class="fas fa-paperclip mr-5"></i> Rapport de stage</a></p>
                        {% endif %}
                    </div>
                </div>

                {% if project.screenshots is not empty %}
                    {% set screenshotsList = project.screenshots|split('::') %}
                    {% if screenshotsList is iterable %}
                        <div class="row justify-content-center pt-20 pb-20">
                            {% for screenshot in screenshotsList %}
                                <div class="col-lg-4 col-md-4 col-sm-6 mb-20">
                                    <div class="nine-shadow bg-white mb-10">
                                        <img class="rounded" src="{{ absolute_url('images/project/' ~ screenshot) }}" alt="{{ project.name }}" />
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="row justify-content-center">
                            <div class="col-lg-4">
                                <div class="nine-shadow">
                                    <img class="rounded" src="{{ absolute_url('images/project/' ~ project.screenshot) }}" alt="{{ project.name }}" />
                                </div>
                            </div>
                        </div>
                    {% endif %}

                {% endif %}
            </div>

            {% if loop.index is odd %}
                {% include 'blocks/curveup.html' with {'color': 'curve-up-color'} %}
            {% elseif loop.last %}
                {% include 'blocks/curveup.html' with {'color': 'curve-up-color-light'} %}
            {% endif %}
        </section>
    {% endfor %}
{% endblock %}
